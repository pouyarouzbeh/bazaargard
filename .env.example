# Bazargard runtime configuration (names and safe placeholders only; release 4.1.0).
# Production (Liara): set these as app environment variables in the Liara console,
# with `liara env:set`, or via POST /v1/projects/update-envs (full replacement!).
# Local / Docker: copy to .env (gitignored). Keep comments on their own lines:
# `docker --env-file` and systemd EnvironmentFile do not strip trailing comments.

# --- Core ---------------------------------------------------------------------
# Public origin; used for seller reply / hold / share links
PUBLIC_BASE_URL=http://127.0.0.1:8506/
# Docker/Liara image default is /data (the persistent disk); local default <repo>/data
#DATA_DIR=/data
#PORT=8080
#FORWARDED_ALLOW_IPS=127.0.0.1

# --- LLM provider switch ---------------------------------------------------------
# anthropic (through the LLM gate + relay) or boxapi
LLM_PROVIDER=boxapi
# Takes over on 429/5xx/credit/timeouts; default = the other provider, empty disables
#LLM_FALLBACK_PROVIDER=boxapi

# Anthropic path: the LLM gate URL and its bearer token (NOT an Anthropic API key;
# the key stays on the relay host)
RELAY_URL=
RELAY_TOKEN=
#ANTHROPIC_MODEL=claude-sonnet-5-5
#ANTHROPIC_LIGHT_MODEL=claude-haiku-5-5

# BoxAPI path (OpenAI-compatible Responses API); keys rotate with fail-over
BOXAPI_BASE_URL=https://ai.boxapi.ir/ai/v1
BOXAPI_KEYS=
#LLM_MODEL=openai/gpt-6.1-sol
#LLM_LIGHT_MODEL=openai/gpt-6-luna
#LLM_FALLBACK_MODELS=openai/gpt-6-sol,openai/gpt-6-luna
#LLM_REASONING_EFFORT=
#LLM_SEARCH_CONCURRENCY=3
#LLM_TOOL_RESULT_CHARS=30000
# Anthropic prompt caching for agent turns (0 disables)
#LLM_PROMPT_CACHE=1
# Optional model override for specification completion; 0 disables model web search
#SPEC_MODEL=
#SPEC_MODEL_SEARCH=1

# --- Observability and admin -------------------------------------------------------
#LOG_LEVEL=info
#LOG_FORMAT=json
#APP_ENV=production
# Enables /api/admin/queue and /api/admin/jobs (Authorization: Bearer <token>); unset = disabled
#ADMIN_TOKEN=<long-random-token>

# --- First-boot catalogue seed (backend/start.py) ------------------------------
# Downloaded once when $DATA_DIR/catalog.db is missing
CATALOG_URL=
CATALOG_TOKEN=
CATALOG_SHA256=

# --- Public data providers (defaults are public endpoints) --------------------------
#OSRM_URL=https://router.project-osrm.org
#OVERPASS_URL=https://overpass.private.coffee/api/interpreter
#HTTP_USER_AGENT=
# Optional fetch gateway for public pages; leave EMPTY to fetch directly
WEB_GATEWAY_URL=
#WEB_GATEWAY_TOKEN=

# --- Ops workspace: Liara API client (read-only unless explicitly enabled) -----
#LIARA_API_TOKEN=<liara-api-token>
# "true" plus an approved action is required for any mutating call
#LIARA_ALLOW_MUTATIONS=false
